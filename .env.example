# ── Sarvam credentials (Settings in the Sarvam dashboard) ──
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=

# ── Your agent (must be a COMMITTED version number) ──
SARVAM_APP_ID=
SARVAM_APP_VERSION=

# ── Deploy → Phone Numbers ──
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=

# ── Campaign the receptionist queues patients into ──
# Leave blank to create one from the app's Campaign page.
SARVAM_CAMPAIGN_ID=

# ── Safety ──
# true  = build + log the Sarvam request (key redacted) but DON'T send it. No phone rings.
# false = really queue patients into the campaign (real calls, real cost).
SARVAM_DRY_RUN=true
# Optional comma-separated E.164 allowlist. If set, ONLY these numbers can be queued.
# Put your own phone here for the first live test.
ALLOWED_PHONE_NUMBERS=

# ── Optional webhook (needs a public tunnel, see README) ──
PUBLIC_BASE_URL=
WEBHOOK_SECRET=

# ── App ──
CLINIC_NAME=Premere Clinic
PORT=5173
SYNC_INTERVAL_SECONDS=30
